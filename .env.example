# Copy to .env and fill in the credential for your chosen provider.
# .env is gitignored; this template must never contain real secrets.
# Run `agentic-finngen --list-providers` for the full provider table.

# --- LLM provider -----------------------------------------------------------
# anthropic | gemini | openai | xai | deepseek | mistral | groq | together |
# openrouter | openai-compatible
LLM_PROVIDER=anthropic

# Model id. Omit to take the provider default, which exists for anthropic and
# gemini only; every other provider requires it. Use --list-models to see what
# your key can reach.
# LLM_MODEL=

# Fill in the key matching LLM_PROVIDER.
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# OPENROUTER_API_KEY=

# Anything else that speaks the OpenAI /chat/completions dialect, including
# local vLLM or Ollama servers. Needs the extra: pip install openai
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=<model served there>

# Gemini via Vertex AI instead of an API key (uses ADC).
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=

# Optional output cap, applied to whichever provider is active.
# LLM_MAX_TOKENS=4096

# --- fganalysis R backend ---------------------------------------------------
# Absolute path to the db_config.json describing the FinnGen registry tables.
FGANALYSIS_CONFIG_PATH=
# Rscript to run the R wrappers with; omit to use whichever is on PATH.
# RSCRIPT_PATH=

# --- logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
AGENTIC_FINNGEN_LOG_LEVEL=INFO
